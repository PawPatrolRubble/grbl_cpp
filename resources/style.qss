/* ============================================================
 *  GrblSender - Light Theme
 *  Clean, modern light interface
 * ============================================================ */

/* ---- Global ---- */
* {
    font-family: "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 12px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
}

QWidget {
    background-color: #f5f5f7;
    color: #1f1f1f;
}

/* ---- Section Titles ---- */
QLabel#sectionTitle {
    font-size: 11px;
    font-weight: bold;
    color: #6b7280;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 4px 0;
}

/* ---- Dock Panel Content Styling ---- */
QWidget#connectionPanel {
    background-color: #ffffff;
    border: 1px solid #3b82f6;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

QWidget#statusPanel {
    background-color: #ffffff;
    border: 1px solid #22c55e;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

QWidget#controlPanel {
    background-color: #ffffff;
    border: 1px solid #6366f1;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

QWidget#jogPanel {
    background-color: #ffffff;
    border: 1px solid #f97316;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

QWidget#settingsPanel {
    background-color: #ffffff;
    border: 1px solid #14b8a6;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

QWidget#graphicsDesignPanel {
    /* Dark theme overrides defined at end of file */
    border: 1px solid #ec4899;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

/* ---- Main Window ---- */
QMainWindow {
    background-color: #f5f5f7;
}

/* ---- Menu Bar ---- */
QMenuBar {
    background-color: #ffffff;
    color: #1f1f1f;
    padding: 4px 0;
    border-bottom: 1px solid #e5e7eb;
    min-height: 24px;
}

QMenuBar::item {
    padding: 6px 12px;
    border-radius: 4px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QMenuBar::item:pressed {
    background-color: #4f46e5;
    color: #ffffff;
}

/* ---- Menus (dropdown) ---- */
QMenu {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 6px 0;
}

QMenu::item {
    padding: 6px 32px 6px 16px;
    border-radius: 4px;
    margin: 1px 4px;
    color: #1f1f1f;
}

QMenu::item:selected {
    background-color: #6366f1;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background-color: #e5e7eb;
    margin: 4px 12px;
}

/* ---- Dock Widgets ---- */
QDockWidget {
    background-color: #f5f5f7;
    border: none;
}

/* Dock widget title bars with accent colors */
QDockWidget#dockConnection::title {
    background-color: #3b82f6;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget#dockStatus::title {
    background-color: #22c55e;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget#dockControl::title {
    background-color: #6366f1;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget#dockJog::title {
    background-color: #f97316;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget#dockSettings::title {
    background-color: #14b8a6;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget#dockGraphicsDesign::title {
    background-color: #ec4899;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 4px;
    subcontrol-position: top right;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: rgba(255, 255, 255, 0.3);
    border-radius: 4px;
}

QDockWidget::close-button:pressed,
QDockWidget::float-button:pressed {
    background-color: rgba(255, 255, 255, 0.2);
}

/* ---- Group Box ---- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px 12px 12px;
    font-weight: bold;
    color: #374151;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #6b7280;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---- Push Buttons ---- */
QPushButton {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 6px 16px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #f9fafb;
    border-color: #6366f1;
}

QPushButton:pressed {
    background-color: #e5e7eb;
    border-color: #4f46e5;
}

QPushButton:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
    border-color: #e5e7eb;
}

/* Primary button (Connect, Start) */
QPushButton#connectBtn,
QPushButton#startBtn {
    background-color: #6366f1;
    border-color: #6366f1;
    color: #ffffff;
}

QPushButton#connectBtn:hover,
QPushButton#startBtn:hover {
    background-color: #4f46e5;
    border-color: #4f46e5;
}

QPushButton#connectBtn:pressed,
QPushButton#startBtn:pressed {
    background-color: #4338ca;
    border-color: #4338ca;
}

/* Danger button (Stop, Disconnect) */
QPushButton#stopBtn,
QPushButton#disconnectBtn {
    background-color: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
}

QPushButton#stopBtn:hover,
QPushButton#disconnectBtn:hover {
    background-color: #dc2626;
    border-color: #dc2626;
}

QPushButton#stopBtn:pressed,
QPushButton#disconnectBtn:pressed {
    background-color: #b91c1c;
    border-color: #b91c1c;
}

/* ---- ComboBox ---- */
QComboBox {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #6366f1;
}

QComboBox:focus {
    border-color: #6366f1;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    subcontrol-origin: padding;
    subcontrol-position: center right;
}

QComboBox::down-arrow {
    image: none;
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #9ca3af;
}

QComboBox:hover::down-arrow {
    border-top-color: #6366f1;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    selection-background-color: #6366f1;
    selection-color: #ffffff;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 4px 8px;
    border-radius: 4px;
    margin: 2px 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #f3f4f6;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #6366f1;
}

/* ---- SpinBox / DoubleSpinBox ---- */
QSpinBox, QDoubleSpinBox {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
}

QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #6366f1;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #6366f1;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: transparent;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #f3f4f6;
    border-radius: 4px;
}

/* ---- Slider ---- */
QSlider::groove:horizontal {
    background-color: #e5e7eb;
    border: none;
    border-radius: 4px;
    height: 6px;
}

QSlider::handle:horizontal {
    background-color: #6366f1;
    border: 2px solid #4f46e5;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin: -6px 0;
}

QSlider::handle:horizontal:hover {
    background-color: #4f46e5;
    border-color: #4338ca;
}

QSlider::sub-page:horizontal {
    background-color: #6366f1;
    border-radius: 4px;
}

/* ---- Label ---- */
QLabel {
    color: #1f1f1f;
    background: transparent;
}

QLabel#titleLabel {
    font-size: 14px;
    font-weight: bold;
    color: #1f1f1f;
}

QLabel#valueLabel {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
    color: #059669;
}

QLabel#stateLabel {
    font-weight: bold;
    font-size: 13px;
    padding: 4px 8px;
    border-radius: 4px;
}

QLabel#stateLabel[state="idle"] {
    color: #ffffff;
    background-color: #22c55e;
}

QLabel#stateLabel[state="alarm"] {
    color: #ffffff;
    background-color: #dc2626;
}

/* ---- Status Bar ---- */
QStatusBar {
    background-color: #ffffff;
    color: #6b7280;
    border-top: 1px solid #e5e7eb;
    padding: 2px 8px;
    font-size: 11px;
}

/* ---- Scroll Bar ---- */
QScrollBar:vertical {
    background-color: #f5f5f7;
    width: 10px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #d1d5db;
    border-radius: 5px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9ca3af;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: #f5f5f7;
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #d1d5db;
    border-radius: 5px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #9ca3af;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---- Tab Widget ---- */
/* Tab widget container */
TabWidget {
    background: #f5f5f7;
}

QTabWidget::pane {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

/* Tab bar */
QTabBar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
}

QTabBar::tab {
    background: #f3f4f6;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    border-bottom: none;
    border-radius: 6px 6px 0 0;
    padding: 8px 24px;
    margin-right: 2px;
    min-width: 80px;
}

QTabBar::tab:hover {
    background: #e5e7eb;
    color: #1f1f1f;
}

QTabBar::tab:selected {
    background: #6366f1;
    color: #ffffff;
    border-color: #6366f1;
}

/* Close button on tabs */
QTabBar::close-button {
    subcontrol-position: right;
    margin-right: 8px;
    width: 16px;
    height: 16px;
}

QTabBar::close-button:hover {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

/* ---- Tool Button ---- */
QToolButton {
    background-color: transparent;
    color: #1f1f1f;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 4px 8px;
}

QToolButton:hover {
    background-color: #f3f4f6;
    border-color: #6366f1;
}

QToolButton:pressed {
    background-color: #e5e7eb;
}

QToolButton::menu-indicator {
    image: none;
}

/* ---- Form Layout Labels ---- */
QFormLayout QLabel {
    color: #6b7280;
    font-size: 11px;
}

/* ---- Position Display (Machine Status) ---- */
QFrame#posFrame {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 8px;
}

QFrame#posFrame QLineEdit#setXEdit,
QFrame#posFrame QLineEdit#setYEdit,
QFrame#posFrame QLineEdit#setZEdit {
    min-width: 30px;
    min-height: 20px;
}

/* Axis-specific colors for position values */
QLabel#posValueX {
    color: #dc2626;  /* Red */
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

QLabel#posValueY {
    color: #16a34a;  /* Green */
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

QLabel#posValueZ {
    color: #2563eb;  /* Blue */
    font-family: "Consolas", "Courier New", monospace;
    font-size: 14px;
    font-weight: bold;
}

/* Axis-specific colors for axis name labels */
QLabel#sideLabelX {
    color: #dc2626;  /* Red */
    font-weight: bold;
}

QLabel#sideLabelY {
    color: #16a34a;  /* Green */
    font-weight: bold;
}

QLabel#sideLabelZ {
    color: #2563eb;  /* Blue */
    font-weight: bold;
}

/* Axis-specific colors for zero buttons */
QPushButton#zeroXBtn,
QPushButton#zeroYBtn,
QPushButton#zeroZBtn {
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0px;
}

QPushButton#zeroXBtn {
    color: #dc2626;  /* Red */
}

QPushButton#zeroYBtn {
    color: #16a34a;  /* Green */
}

QPushButton#zeroZBtn {
    color: #2563eb;  /* Blue */
}

/* Emergency stop button */
QPushButton#eStopBtn {
    background-color: #dc2626;
    border: 2px solid #991b1b;
    color: #ffffff;
    font-weight: bold;
    font-size: 14px;
    border-radius: 6px;
}

QPushButton#eStopBtn:hover {
    background-color: #b91c1c;
    border-color: #7f1d1d;
}

QPushButton#eStopBtn:pressed {
    background-color: #991b1b;
    border-color: #7f1d1d;
}

/* Home button */
QPushButton#homeBtn {
    background-color: #f59e0b;
    border-color: #d97706;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#homeBtn:hover {
    background-color: #d97706;
    border-color: #b45309;
}

QPushButton#homeBtn:pressed {
    background-color: #b45309;
    border-color: #92400e;
}

/* ---- G-code List Widget ---- */
QLabel#gcodeCountLabel {
    background-color: #f3f4f6;
    color: #6366f1;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
}

QLabel#posLabel {
    color: #9ca3af;
    font-size: 10px;
    text-transform: uppercase;
}

/* ---- Console Panel ---- */
QWidget#consolePanel {
    background-color: #ffffff;
    border: 1px solid #eab308;
    border-radius: 6px;
}

QLabel#consoleTitle {
    background-color: #eab308;
    color: #ffffff;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QPlainTextEdit#consoleEdit {
    background-color: #ffffff;
    color: #1f1f1f;
    border: none;
    padding: 8px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
    selection-background-color: #6366f1;
}

/* ---- Progress Bar ---- */
QProgressBar {
    background-color: #e5e7eb;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #1f1f1f;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #6366f1;
    border-radius: 5px;
}

/* ---- Checkbox ---- */
QCheckBox {
    color: #1f1f1f;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #d1d5db;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #6366f1;
}

QCheckBox::indicator:checked {
    background-color: #6366f1;
    border-color: #6366f1;
}

QCheckBox::indicator:disabled {
    background-color: #f3f4f6;
    border-color: #e5e7eb;
}

/* ---- Line Edit ---- */
QLineEdit {
    background-color: #ffffff;
    color: #1f1f1f;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #6366f1;
}

QLineEdit:focus {
    border-color: #6366f1;
}

QLineEdit:disabled {
    background-color: #f3f4f6;
    color: #9ca3af;
}

/* ---- Canvas Background ---- */
QFrame#canvasFrame {
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
}

/* ---- Action Buttons (Save, Load, Export) ---- */
QPushButton#actionBtn {
    background-color: #ffffff;
    color: #374151;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    padding: 7px 12px;
    font-weight: 500;
    min-width: 100px;
}

QPushButton#actionBtn:hover {
    background-color: #f3f4f6;
    border-color: #9ca3af;
}

QPushButton#actionBtn:pressed {
    background-color: #d1d5db;
}

/* ---- Import Buttons ---- */
QPushButton#importBtn {
    background-color: #10b981;
    border-color: #10b981;
    color: #ffffff;
    padding: 7px 12px;
    min-width: 100px;
    font-weight: 500;
    border-radius: 6px;
}

QPushButton#importBtn:hover {
    background-color: #059669;
    border-color: #059669;
}

QPushButton#importBtn:pressed {
    background-color: #047857;
    border-color: #047857;
}

/* ============================================================
 *  Design Panel — Dark CAD Theme
 *  Only applies to children of QWidget#graphicsDesignPanel
 * ============================================================ */

QWidget#graphicsDesignPanel {
    background-color: #1e1e1e;
    border: 1px solid #ec4899;
    border-top: none;
    border-radius: 0 0 6px 6px;
}

QWidget#graphicsDesignPanel QGroupBox {
    background-color: #252525;
    border: 1px solid #3d3d3d;
    border-radius: 6px;
    color: #a0a0a0;
    margin-top: 12px;
    padding: 16px 10px 10px;
    font-weight: bold;
    font-size: 11px;
}

QWidget#graphicsDesignPanel QGroupBox::title {
    color: #7c9cc0;
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 6px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QWidget#graphicsDesignPanel QLabel {
    color: #b0b0b0;
    background: transparent;
}

QWidget#graphicsDesignPanel QPushButton {
    background-color: #2d2d2d;
    color: #d0d0d0;
    border: 1px solid #4d4d4d;
    border-radius: 5px;
    padding: 5px 12px;
}

QWidget#graphicsDesignPanel QPushButton:hover {
    background-color: #383838;
    border-color: #6496c8;
    color: #ffffff;
}

QWidget#graphicsDesignPanel QPushButton:pressed {
    background-color: #444;
    border-color: #4878a0;
}

QWidget#graphicsDesignPanel QPushButton#undoBtn,
QWidget#graphicsDesignPanel QPushButton#redoBtn {
    background-color: #2a2a2a;
    color: #909090;
    border-color: #404040;
}

QWidget#graphicsDesignPanel QPushButton#actionBtn {
    background-color: #2a3a4a;
    color: #90b8d8;
    border: 1px solid #3a5a78;
}

QWidget#graphicsDesignPanel QPushButton#actionBtn:hover {
    background-color: #344a5c;
    border-color: #5888a8;
    color: #c0daf0;
}

QWidget#graphicsDesignPanel QPushButton#importBtn {
    background-color: #1a3a2a;
    border-color: #2a5a3a;
    color: #60c878;
}

QWidget#graphicsDesignPanel QPushButton#importBtn:hover {
    background-color: #204830;
    border-color: #3a7050;
}

QWidget#graphicsDesignPanel QPushButton#startBtn {
    background-color: #2a3d5c;
    border-color: #3a5d8c;
    color: #80b0e0;
}

QWidget#graphicsDesignPanel QComboBox {
    background-color: #2d2d2d;
    color: #d0d0d0;
    border: 1px solid #4d4d4d;
    border-radius: 5px;
    padding: 3px 8px;
}

QWidget#graphicsDesignPanel QComboBox:hover {
    border-color: #6496c8;
}

QWidget#graphicsDesignPanel QComboBox::drop-down {
    border: none;
    width: 20px;
}

QWidget#graphicsDesignPanel QComboBox QAbstractItemView {
    background-color: #282828;
    color: #d0d0d0;
    border: 1px solid #4d4d4d;
    selection-background-color: #3a5a80;
    selection-color: #ffffff;
}

QWidget#graphicsDesignPanel QSpinBox,
QWidget#graphicsDesignPanel QDoubleSpinBox {
    background-color: #2d2d2d;
    color: #d0d0d0;
    border: 1px solid #4d4d4d;
    border-radius: 5px;
    padding: 3px 8px;
}

QWidget#graphicsDesignPanel QSpinBox:hover,
QWidget#graphicsDesignPanel QDoubleSpinBox:hover {
    border-color: #6496c8;
}

QWidget#graphicsDesignPanel QSpinBox:focus,
QWidget#graphicsDesignPanel QDoubleSpinBox:focus {
    border-color: #5080b0;
}

QWidget#graphicsDesignPanel QCheckBox {
    color: #b0b0b0;
}

QWidget#graphicsDesignPanel QCheckBox::indicator {
    background-color: #2d2d2d;
    border: 2px solid #5d5d5d;
    border-radius: 3px;
}

QWidget#graphicsDesignPanel QCheckBox::indicator:hover {
    border-color: #6496c8;
}

QWidget#graphicsDesignPanel QCheckBox::indicator:checked {
    background-color: #4878a0;
    border-color: #4878a0;
}

QWidget#graphicsDesignPanel QScrollArea {
    background-color: #1e1e1e;
    border: none;
}

QWidget#graphicsDesignPanel QScrollBar:vertical {
    background-color: #252525;
    width: 8px;
}

QWidget#graphicsDesignPanel QScrollBar::handle:vertical {
    background-color: #4d4d4d;
    border-radius: 4px;
    min-height: 20px;
}

QWidget#graphicsDesignPanel QScrollBar::handle:vertical:hover {
    background-color: #6496c8;
}
